<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="04-05-26-03" author="Yeghor Danyliuk">
        <createTable tableName="instructor">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="experience" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="speciality" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="04-05-26-02" author="Yeghor Danyliuk">
        <createTable tableName="student">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="registrationDate" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="04-05-26-01" author="Yeghor Danyliuk">
        <createTable tableName="course">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="length" type="int"/>
            <column name="price" type="double"/>
            <column name="instructor_id" type="int">
                <constraints foreignKeyName="fk_course_instructor"
                             referencedTableName="instructor"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="04-05-26-04" author="Yeghor Danyliuk">
        <createTable tableName="lesson">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="text"/>
            <column name="course_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_lesson_course"
                             referencedTableName="course"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="04-05-26-05" author="Yeghor Danyliuk">
        <createTable tableName="review">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rating" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="text"/>
            <column name="author_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_review_student"
                             referencedTableName="student"
                             referencedColumnNames="id"/>
            </column>
            <column name="course_id" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_review_course"
                             referencedTableName="course"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="04-05-26-06" author="Yeghor Danyliuk">
        <createTable tableName="course_students">
            <column name="course_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_cs_course" referencedTableName="course" referencedColumnNames="id"/>
            </column>
            <column name="student_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_cs_student" referencedTableName="student" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="23-05-26-01" author="Yeghor Danyliuk">
        <addColumn tableName="lesson">
            <column name="instructor_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_instructor" referencedTableName="instructor" referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>